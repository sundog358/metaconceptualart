    rdfs:label "Metaconceptual Art - www.wtfisart.com";
    la:access_point <https://www.metaconceptualart.com/artworks/wtfisart>.
_:b0_r22b10 crm:P190_has_symbolic_content "The website was built by Sun & Rain Works around 2009 in connection with its Sotheby's Photographs auction engagement; it is not recorded as having been authored live in the auction room.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
_:b0_r22b2 crm:P190_has_symbolic_content "www.wtfisart.com";
    crm:P2_has_type aat:300404670;
    crm:P72_has_language aat:300388277;
    a crm:E33_E41_Linguistic_Appellation.
_:b0_r22b3 crm:P190_has_symbolic_content "work:wtfisart";
    crm:P2_has_type aat:300312355;
    a crm:E42_Identifier.
_:b0_r22b4 crm:P190_has_symbolic_content "https://www.wtfisart.com/";
    crm:P2_has_type aat:300404626;
    a crm:E42_Identifier.
_:b0_r22b5 crm:P190_has_symbolic_content "A born-digital Metaconceptual Art work: a website built and owned by Sun & Rain Works around 2009, in connection with its Sotheby's Photographs auction engagement (sale N08533). Sun & Rain Works designates it as an associated part of the conceptual work The Auction as Artwork.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
_:b0_r22b6 crm:P190_has_symbolic_content "www.wtfisart.com is associated by Sun & Rain Works with the conceptual work The Auction as Artwork, in which Sun & Rain Works designates its 2009 Sotheby's Photographs auction engagement as art. The designation is an assertion by the artist.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
_:b0_r22b7 crm:P190_has_symbolic_content "Sun & Rain Works reports domain-registration and hosting receipts, site metadata, and related records documenting the website's existence and date. The fuller archive remains held by the studio pending redaction and rights review.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
