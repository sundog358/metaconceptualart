_:b0_r6b2 crm:P190_has_symbolic_content "Eightfold Sprocket";
    crm:P2_has_type aat:300404670;
    crm:P72_has_language aat:300388277;
    a crm:E33_E41_Linguistic_Appellation.
_:b0_r6b3 crm:P190_has_symbolic_content "work:eightfold-sprocket";
    crm:P2_has_type aat:300312355;
    a crm:E42_Identifier.
_:b0_r6b4 crm:P190_has_symbolic_content "An emblem for the eight-sentence proposition set: a small mechanical sign for repetition, rotation, and system.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
