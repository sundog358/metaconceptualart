    a crm:E42_Identifier.
_:b0_r25b4 crm:P190_has_symbolic_content "The knowledge graph treated as an artwork: relations, authorities, claims, and viewers arranged as a walkable system.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
