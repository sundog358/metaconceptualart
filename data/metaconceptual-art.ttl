_:b0_r12b1 crm:P190_has_symbolic_content "Sun & Rain Works' conceptual claim to art at auction (2009)";
    crm:P2_has_type aat:300404670;
    crm:P72_has_language aat:300388277;
    a crm:E33_E41_Linguistic_Appellation.
_:b0_r12b2 crm:P190_has_symbolic_content "record:priority-live-auction-2009";
    crm:P2_has_type aat:300312355;
    a crm:E42_Identifier.
_:b0_r12b3 crm:P190_has_symbolic_content "Supporting documentation is described at evidence-live-auction-2009 and includes 2008 Sotheby's correspondence and the public catalogue lot. Recommended framing: the artist's asserted conceptual designation of an auction engagement. Avoided claims: 'first in history', publicly witnessed live creation, or precedence over any later artist or event, absent independent recognition and separately published evidence.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
_:b0_r12b4 crm:P14_carried_out_by mca:sun-and-rain-works;
    crm:P4_has_time-span _:b0_r12b5;
    a crm:E65_Creation;
    rdfs:label "Writing of the conceptual-claim statement".
