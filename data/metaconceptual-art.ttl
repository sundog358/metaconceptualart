_:b0_r5b2 <http://purl.org/dc/elements/1.1/format> "text/html";
    a <http://www.ics.forth.gr/isl/CRMdig/D1_Digital_Object>;
    rdfs:label "Metaconceptual Art — Artworks";
    la:access_point <https://www.metaconceptualart.com/artworks#work-eight-sentences>.
_:b0_r5b3 crm:P190_has_symbolic_content "Eight Sentences On Metaconceptual Art";
    crm:P2_has_type aat:300404670;
    crm:P72_has_language aat:300388277;
    a crm:E33_E41_Linguistic_Appellation.
_:b0_r5b4 crm:P190_has_symbolic_content "work:eight-sentences";
    crm:P2_has_type aat:300312355;
    a crm:E42_Identifier.
_:b0_r5b5 crm:P190_has_symbolic_content "A canonical eight-sentence proposition set framing Metaconceptual Art as a field of form, institution, market, history, medium, access, and life. Written after Sol LeWitt's Sentences on Conceptual Art.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
_:b0_r5b6 crm:P190_has_symbolic_content "The sequence has a documented public form predating this site by fourteen years. It was posted in full, as 'The 8 Defining characteristics of Metaconceptual Art', on 2012-11-22, and the text published here agrees with that posting word for word apart from a comma, a space, and the spelling of 'Transcendance', since normalised. The posting is described in the 2011-2012 posting evidence record. The stated debt to Sol LeWitt does not appear in the 2012 text and is a later framing.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
_:b0_r5b7 crm:P14_carried_out_by mca:sun-and-rain-works;
    crm:P15_was_influenced_by ulan:500115429;
    crm:P4_has_time-span _:b0_r5b8;
    a crm:E65_Creation;
    rdfs:label "Writing of the Eight Sentences".
_:b0_r5b8 crm:P82a_begin_of_the_begin "2026-01-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
    crm:P82b_end_of_the_end "2026-12-31T23:59:59Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
    a crm:E52_Time-Span;
    rdfs:label "2026".
_:b0_r6b0 a crm:E33_Linguistic_Object;
