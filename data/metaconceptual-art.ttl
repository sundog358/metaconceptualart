_:b0_r0b0 a crm:E33_Linguistic_Object;
    rdfs:label "Artwork page";
    la:digitally_carried_by _:b0_r0b1.
_:b0_r0b1 <http://purl.org/dc/elements/1.1/format> "text/html";
