_:b0_r13b3 crm:P190_has_symbolic_content "Proof of Movement: Metaconceptual Art";
    crm:P2_has_type aat:300404670;
    crm:P72_has_language aat:300388277;
    a crm:E33_E41_Linguistic_Appellation.
_:b0_r13b4 crm:P190_has_symbolic_content "work:movement-record";
    crm:P2_has_type aat:300312355;
    a crm:E42_Identifier.
_:b0_r13b5 crm:P190_has_symbolic_content "The Movement Record turns the claim for Metaconceptual Art into a citable textual work and a machine-readable evidence surface. It distinguishes local validity from external canonization while pointing to Linked Art, Wikidata, Getty vocabularies, IIIF, schema.org, and the git-derived Activity Stream.";
    crm:P2_has_type aat:300435416;
    a crm:E33_Linguistic_Object.
_:b0_r13b6 crm:P14_carried_out_by mca:sun-and-rain-works;
